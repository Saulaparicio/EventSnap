generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  plan      Plan     @default(free)
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id              String       @id @default(uuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  slug            String       @unique
  date            DateTime
  status          EventStatus  @default(active)
  watermarkConfig Json         @default("{}")
  slideshowConfig Json         @default("{}")
  qrCodeUrl       String?
  createdAt       DateTime     @default(now())
  photos          Photo[]
}

model Photo {
  id             String      @id @default(uuid())
  eventId        String
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalUrl    String
  watermarkedUrl String?
  thumbnailUrl   String?
  status         PhotoStatus @default(pending)
  uploadedAt     DateTime    @default(now())
  fileSize       Int?
  width          Int?
  height         Int?
}

enum Plan {
  free
  pro
  business
}

enum EventStatus {
  active
  closed
  archived
}

enum PhotoStatus {
  pending
  approved
  rejected
}
